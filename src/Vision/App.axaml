<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Vision.App"
             Name="Vision"
             xmlns:local="using:Vision"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant; the settings may pick "Dark" or "Light". -->

    <!-- the application menu of macOS; Avalonia adds the usual items (hide, quit) after them -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="About Vision" Click="OnAboutClicked" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Settings…" Gesture="Cmd+OemComma" Click="OnSettingsClicked" />
            <NativeMenuItem Header="New Window" Gesture="Cmd+N" Click="OnNewWindowClicked" />
        </NativeMenu>
    </NativeMenu.Menu>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ChromeToolbarBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ChromeDividerBrush" Color="#E1E3E6" />
                    <SolidColorBrush x:Key="ChromeIconBrush" Color="#474747" />
                    <SolidColorBrush x:Key="ChromeHoverBrush" Color="#14000000" />
                    <SolidColorBrush x:Key="ChromePressedBrush" Color="#24000000" />
                    <SolidColorBrush x:Key="ChromeFieldBrush" Color="#E9EEF6" />
                    <SolidColorBrush x:Key="ChromeFieldHoverBrush" Color="#DFE4EC" />
                    <SolidColorBrush x:Key="ChromeFieldFocusBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ChromeTextBrush" Color="#1F1F1F" />
                    <SolidColorBrush x:Key="ChromeMutedTextBrush" Color="#5F6368" />
                    <SolidColorBrush x:Key="ChromeAccentBrush" Color="#0B57D0" />
                    <SolidColorBrush x:Key="ChromeAlertBrush" Color="#D93025" />
                    <SolidColorBrush x:Key="ChromeBubbleBrush" Color="#F1F3F4" />
                    <SolidColorBrush x:Key="ChromeMenuBrush" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ChromeToolbarBrush" Color="#3C3C3C" />
                    <SolidColorBrush x:Key="ChromeDividerBrush" Color="#2A2A2A" />
                    <SolidColorBrush x:Key="ChromeIconBrush" Color="#C7C7C7" />
                    <SolidColorBrush x:Key="ChromeHoverBrush" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="ChromePressedBrush" Color="#33FFFFFF" />
                    <SolidColorBrush x:Key="ChromeFieldBrush" Color="#282828" />
                    <SolidColorBrush x:Key="ChromeFieldHoverBrush" Color="#303030" />
                    <SolidColorBrush x:Key="ChromeFieldFocusBrush" Color="#202124" />
                    <SolidColorBrush x:Key="ChromeTextBrush" Color="#E3E3E3" />
                    <SolidColorBrush x:Key="ChromeMutedTextBrush" Color="#A8ABB0" />
                    <SolidColorBrush x:Key="ChromeAccentBrush" Color="#A8C7FA" />
                    <SolidColorBrush x:Key="ChromeAlertBrush" Color="#F28B82" />
                    <SolidColorBrush x:Key="ChromeBubbleBrush" Color="#35363A" />
                    <SolidColorBrush x:Key="ChromeMenuBrush" Color="#2B2B2B" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Material symbols (24x24) used by the toolbar and its menu -->
            <StreamGeometry x:Key="BackIcon">M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z</StreamGeometry>
            <StreamGeometry x:Key="ForwardIcon">M4,11V13H16L10.5,18.5L11.92,19.92L19.84,12L11.92,4.08L10.5,5.5L16,11H4Z</StreamGeometry>
            <StreamGeometry x:Key="ReloadIcon">M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z</StreamGeometry>
            <StreamGeometry x:Key="MoreIcon">M12,16A2,2 0 0,1 14,18A2,2 0 0,1 12,20A2,2 0 0,1 10,18A2,2 0 0,1 12,16M12,10A2,2 0 0,1 14,12A2,2 0 0,1 12,14A2,2 0 0,1 10,12A2,2 0 0,1 12,10M12,4A2,2 0 0,1 14,6A2,2 0 0,1 12,8A2,2 0 0,1 10,6A2,2 0 0,1 12,4Z</StreamGeometry>
            <StreamGeometry x:Key="SecureIcon">M12,17C10.89,17 10,16.1 10,15C10,13.89 10.89,13 12,13A2,2 0 0,1 14,15A2,2 0 0,1 12,17M18,20V10H6V20H18M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6C4.89,22 4,21.1 4,20V10C4,8.89 4.89,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z</StreamGeometry>
            <StreamGeometry x:Key="InfoIcon">M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z</StreamGeometry>
            <StreamGeometry x:Key="DiagnosticsIcon">M3,13H5.79L10.1,4.79L11.28,13.75L14.5,9.66L17.83,13H21V15H17L14.67,12.67L9.92,18.73L8.94,11.31L7,15H3V13Z</StreamGeometry>
            <StreamGeometry x:Key="InspectorIcon">M3,3H9V7H3V3M15,10H21V14H15V10M15,17H21V21H15V17M13,13H7V18H13V20H7L5,20V9H7V11H13V13Z</StreamGeometry>
            <StreamGeometry x:Key="SettingsIcon">M3,17V19H9V17H3M3,5V7H13V5H3M13,21V19H21V17H13V15H11V21H13M7,9V11H3V13H7V15H9V9H7M21,13V11H11V13H21M15,9H17V7H21V5H17V3H15V9Z</StreamGeometry>
            <StreamGeometry x:Key="NewWindowIcon">M19,19H5V5H12V3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V12H19V19M14,3V5H17.59L7.76,14.83L9.17,16.24L19,6.41V10H21V3H14Z</StreamGeometry>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- a slow, faint glow behind a button, asking for a look at what is behind it -->
        <Style Selector="Ellipse.attention">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Ellipse.attention.pulsing">
            <Style.Animations>
                <Animation Duration="0:0:3" IterationCount="Infinite" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.18" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- round, borderless toolbar buttons -->
        <Style Selector="Button.icon">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ChromeHoverBrush}" />
        </Style>
        <Style Selector="Button.icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ChromePressedBrush}" />
        </Style>
        <Style Selector="Button.icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.icon PathIcon">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Foreground" Value="{DynamicResource ChromeIconBrush}" />
        </Style>
        <Style Selector="Button.icon:disabled PathIcon">
            <Setter Property="Opacity" Value="0.35" />
        </Style>

        <!-- the site information button inside of the address bar -->
        <Style Selector="Button.icon.site">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
        <Style Selector="Button.icon.site PathIcon">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource ChromeMutedTextBrush}" />
        </Style>

        <!-- the address bar: a pill, which lights up while typing -->
        <Style Selector="Border.omnibox">
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="{DynamicResource ChromeFieldBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Border.omnibox:pointerover">
            <Setter Property="Background" Value="{DynamicResource ChromeFieldHoverBrush}" />
        </Style>
        <Style Selector="Border.omnibox:focus-within">
            <Setter Property="Background" Value="{DynamicResource ChromeFieldFocusBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeAccentBrush}" />
        </Style>
        <Style Selector="TextBox.bare">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource ChromeTextBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.bare:pointerover /template/ Border#PART_BorderElement, TextBox.bare:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.bare:pointerover, TextBox.bare:focus">
            <Setter Property="Foreground" Value="{DynamicResource ChromeTextBrush}" />
        </Style>

        <!-- the "more" menu -->
        <Style Selector="MenuFlyoutPresenter">
            <Setter Property="Background" Value="{DynamicResource ChromeMenuBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="0,6" />
            <Setter Property="MinWidth" Value="240" />
        </Style>
        <Style Selector="MenuFlyoutPresenter MenuItem">
            <Setter Property="Padding" Value="14,9" />
        </Style>
        <Style Selector="MenuFlyoutPresenter MenuItem PathIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource ChromeIconBrush}" />
        </Style>
    </Application.Styles>
</Application>
