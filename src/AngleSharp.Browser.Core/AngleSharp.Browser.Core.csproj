<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>AngleSharp.Browser</RootNamespace>
    <Description>A UI-agnostic browser engine bringing the AngleSharp ecosystem together.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AngleSharp.Browser.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.9.1-local.1" />
    <PackageReference Include="AngleSharp.Js" Version="1.1.4-local.7" />
    <PackageReference Include="AngleSharp.Css" Version="1.3.1-local.1" />
    <PackageReference Include="AngleSharp.Io" Version="1.2.2-local.2" />
    <PackageReference Include="AngleSharp.Wasm" Version="1.1.0" />
    <PackageReference Include="AngleSharp.Xml" Version="1.2.0" />
    <PackageReference Include="AngleSharp.Renderer" Version="0.9.2-local.41" />
  </ItemGroup>

  <ItemGroup>
    <!-- AngleSharp.Renderer is built against SkiaSharp 2.88, but works with 3.x; align with the version Avalonia uses -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
  </ItemGroup>
</Project>
