<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>A UI-agnostic browser engine bringing the AngleSharp ecosystem together.</Description>
    <Product>AngleSharp.Browser</Product>
    <PackageTags>html;css;javascript;browser;rendering;headless;anglesharp;angle</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AngleSharp.Browser.Tests" Key="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.10.6-beta.974" />
    <PackageReference Include="AngleSharp.Js" Version="1.2.3-beta.241" />
    <PackageReference Include="AngleSharp.Css" Version="1.5.1-beta.460" />
    <PackageReference Include="AngleSharp.Io" Version="1.3.4-beta.125" />
    <PackageReference Include="AngleSharp.Wasm" Version="1.1.1" />
    <PackageReference Include="AngleSharp.Xml" Version="1.3.1-beta.91" />
    <PackageReference Include="AngleSharp.Renderer" Version="0.12.1-beta.224" />
  </ItemGroup>

  <ItemGroup>
    <!-- the audio decoders, all managed (see AudioCodecs) -->
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="Concentus.OggFile" Version="1.0.7" />
    <PackageReference Include="NLayer" Version="3.0.0" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- AngleSharp.Renderer is built against SkiaSharp 2.88, but works with 3.x; align with the version Avalonia uses -->
    <PackageReference Include="SkiaSharp" Version="4.156.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.156.1" />
  </ItemGroup>
</Project>
