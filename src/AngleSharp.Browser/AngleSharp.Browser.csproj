<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>A UI-agnostic browser engine bringing the AngleSharp ecosystem together.</Description>
    <Product>AngleSharp.Browser</Product>
    <PackageTags>html;css;javascript;browser;rendering;headless;anglesharp;angle</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AngleSharp.Browser.Tests" Key="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.10.3" />
    <PackageReference Include="AngleSharp.Js" Version="1.2.1" />
    <PackageReference Include="AngleSharp.Css" Version="1.4.2" />
    <PackageReference Include="AngleSharp.Io" Version="1.3.2" />
    <PackageReference Include="AngleSharp.Wasm" Version="1.1.1" />
    <PackageReference Include="AngleSharp.Xml" Version="1.3.0" />
    <PackageReference Include="AngleSharp.Renderer" Version="0.11.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- AngleSharp.Renderer is built against SkiaSharp 2.88, but works with 3.x; align with the version Avalonia uses -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
  </ItemGroup>
</Project>
